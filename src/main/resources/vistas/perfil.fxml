<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.fintech.controlador.PerfilControlador"
      styleClass="contenido">
    <VBox styleClass="tarjeta" maxWidth="520" spacing="12">
        <Label text="Mis datos" styleClass="subtitulo"/>
        <Label fx:id="etiquetaResumen" styleClass="texto-secundario" wrapText="true"/>
        <VBox spacing="4">
            <Label text="Cédula"/>
            <TextField fx:id="campoCedula" disable="true"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Nombre"/>
            <TextField fx:id="campoNombre"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Correo"/>
            <TextField fx:id="campoCorreo"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Teléfono"/>
            <TextField fx:id="campoTelefono"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Nueva contraseña (déjala vacía para no cambiarla)"/>
            <PasswordField fx:id="campoContrasena"/>
        </VBox>
        <Button text="Guardar cambios" styleClass="boton-principal" onAction="#guardar"/>
        <Label fx:id="etiquetaMensaje" wrapText="true"/>
    </VBox>
</VBox>
