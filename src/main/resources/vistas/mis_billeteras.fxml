<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.fintech.controlador.MisBilleterasControlador"
      styleClass="contenido">
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Nueva billetera" styleClass="boton-principal" onAction="#nueva"/>
        <Button text="Renombrar" onAction="#renombrar"/>
        <Button text="Bloquear" onAction="#bloquear"/>
        <Button text="Desbloquear" onAction="#desbloquear"/>
        <Button text="Cerrar" styleClass="boton-peligro" onAction="#cerrar"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Doble clic en una billetera para ver su historial" styleClass="texto-secundario"/>
    </HBox>
    <TableView fx:id="tablaBilleteras" VBox.vgrow="ALWAYS"/>
    <Label fx:id="etiquetaMensaje" wrapText="true"/>
</VBox>
