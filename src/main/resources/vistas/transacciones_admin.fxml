<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.fintech.controlador.TransaccionesAdminControlador"
      styleClass="contenido">
    <HBox spacing="8" alignment="BOTTOM_LEFT">
        <Button text="Ver todas" onAction="#verTodas"/>
        <Region prefWidth="16"/>
        <VBox spacing="4">
            <Label text="Cantidad (N)"/>
            <TextField fx:id="campoCantidad" text="10" prefWidth="80"/>
        </VBox>
        <Button text="Top N por valor" styleClass="boton-principal" onAction="#verTop"/>
        <Region prefWidth="16"/>
        <VBox spacing="4">
            <Label text="Desde"/>
            <DatePicker fx:id="campoDesde" prefWidth="140"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Hasta"/>
            <DatePicker fx:id="campoHasta" prefWidth="140"/>
        </VBox>
        <Button text="Ver período" onAction="#verPeriodo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="botonRevertir" text="Revertir" styleClass="boton-peligro" onAction="#revertir"/>
    </HBox>
    <Label fx:id="etiquetaListado" styleClass="texto-secundario"/>
    <TableView fx:id="tablaTransacciones" VBox.vgrow="ALWAYS"/>
    <Label fx:id="etiquetaMensaje" wrapText="true"/>
</VBox>
