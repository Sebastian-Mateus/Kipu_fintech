<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.fintech.controlador.HistorialControlador"
      styleClass="contenido">
    <HBox spacing="8" alignment="BOTTOM_LEFT">
        <VBox spacing="4">
            <Label text="Tipo"/>
            <ComboBox fx:id="filtroTipo" prefWidth="200"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Desde"/>
            <DatePicker fx:id="filtroDesde" prefWidth="150"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Hasta"/>
            <DatePicker fx:id="filtroHasta" prefWidth="150"/>
        </VBox>
        <Button text="Filtrar" styleClass="boton-principal" onAction="#filtrar"/>
        <Button text="Limpiar" onAction="#limpiar"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="botonRevertir" text="Revertir" styleClass="boton-peligro" onAction="#revertir"/>
    </HBox>
    <TableView fx:id="tablaHistorial" VBox.vgrow="ALWAYS"/>
    <Label fx:id="etiquetaMensaje" wrapText="true"
           text="Solo se pueden revertir recargas, transferencias y pagos programados exitosos de las últimas 24 horas."
           styleClass="texto-secundario"/>
</VBox>
