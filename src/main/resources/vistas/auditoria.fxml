<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.fintech.controlador.AuditoriaControlador"
      styleClass="contenido">
    <HBox spacing="8" alignment="BOTTOM_LEFT">
        <VBox spacing="4">
            <Label text="Usuario"/>
            <ComboBox fx:id="filtroUsuario" prefWidth="260"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Nivel de riesgo"/>
            <ComboBox fx:id="filtroRiesgo" prefWidth="180"/>
        </VBox>
        <Button text="Filtrar" styleClass="boton-principal" onAction="#filtrar"/>
        <Button text="Limpiar" onAction="#limpiar"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="etiquetaResumen" styleClass="texto-secundario"/>
    </HBox>
    <TableView fx:id="tablaEventos" VBox.vgrow="ALWAYS"/>
    <Label text="Bajo: se marca y se registra · Medio: además se envía alerta al usuario · Alto: la transacción se rechaza automáticamente"
           styleClass="texto-secundario" wrapText="true"/>
</VBox>
