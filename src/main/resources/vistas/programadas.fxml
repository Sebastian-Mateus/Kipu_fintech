<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.fintech.controlador.ProgramadasControlador"
      styleClass="contenido">
    <ScrollPane fitToWidth="true" minWidth="340" prefWidth="340">
        <VBox styleClass="tarjeta" spacing="12">
            <Label text="Programar operación" styleClass="subtitulo"/>
            <VBox spacing="4">
                <Label text="Tipo"/>
                <ComboBox fx:id="comboTipo" maxWidth="Infinity"/>
            </VBox>
            <VBox fx:id="cajaOrigen" spacing="4">
                <Label text="Billetera de origen"/>
                <ComboBox fx:id="comboOrigen" maxWidth="Infinity"/>
            </VBox>
            <VBox fx:id="cajaDestinoPropia" spacing="4">
                <Label text="Billetera destino"/>
                <ComboBox fx:id="comboDestino" maxWidth="Infinity"/>
            </VBox>
            <VBox fx:id="cajaDestinoCodigo" spacing="4">
                <Label text="Código de la billetera destino"/>
                <TextField fx:id="campoDestinoCodigo" promptText="Ej: BIL-0004"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Monto"/>
                <TextField fx:id="campoMonto"/>
            </VBox>
            <HBox spacing="8">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Fecha"/>
                    <DatePicker fx:id="campoFecha" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" prefWidth="90">
                    <Label text="Hora"/>
                    <TextField fx:id="campoHora" text="08:00"/>
                </VBox>
            </HBox>
            <VBox spacing="4">
                <Label text="Frecuencia"/>
                <ComboBox fx:id="comboFrecuencia" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Descripción"/>
                <TextField fx:id="campoDescripcion" promptText="Ej: Pago del arriendo"/>
            </VBox>
            <Button text="Programar" styleClass="boton-principal" maxWidth="Infinity" onAction="#programar"/>
            <Label fx:id="etiquetaMensaje" wrapText="true"/>
        </VBox>
    </ScrollPane>
    <VBox spacing="8" HBox.hgrow="ALWAYS">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Mis operaciones activas" styleClass="subtitulo"/>
            <Button text="Cancelar seleccionada" styleClass="boton-peligro" onAction="#cancelar"/>
        </HBox>
        <TableView fx:id="tablaProgramadas" VBox.vgrow="ALWAYS"/>
    </VBox>
</HBox>
