<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="co.edu.uniquindio.fintech.controlador.RegistroControlador"
           styleClass="fondo-login">
    <VBox styleClass="tarjeta, tarjeta-login" maxWidth="560" maxHeight="-Infinity" spacing="16">
        <Label text="Crear cuenta" styleClass="titulo"/>
        <Label text="Llena tus datos para empezar a usar Kipu" styleClass="texto-secundario"/>
        <GridPane hgap="16" vgap="8">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Cédula"/>
                <TextField fx:id="campoCedula"/>
            </VBox>
            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Nombre completo"/>
                <TextField fx:id="campoNombre"/>
            </VBox>
            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="Correo"/>
                <TextField fx:id="campoCorreo"/>
            </VBox>
            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="Teléfono"/>
                <TextField fx:id="campoTelefono"/>
            </VBox>
            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label text="Contraseña"/>
                <PasswordField fx:id="campoContrasena"/>
            </VBox>
            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label text="Confirmar contraseña"/>
                <PasswordField fx:id="campoConfirmacion"/>
            </VBox>
        </GridPane>
        <Label fx:id="etiquetaError" styleClass="mensaje-error" wrapText="true"/>
        <Button text="Registrarme" defaultButton="true" maxWidth="Infinity" styleClass="boton-principal"
                onAction="#registrar"/>
        <HBox alignment="CENTER" spacing="4">
            <Label text="¿Ya tienes cuenta?" styleClass="texto-secundario"/>
            <Hyperlink text="Inicia sesión" onAction="#volver"/>
        </HBox>
    </VBox>
</StackPane>
