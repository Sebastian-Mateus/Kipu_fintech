<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.fintech.controlador.AnaliticaControlador"
            fitToWidth="true">
    <VBox styleClass="contenido">
        <HBox spacing="16">
            <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Usuarios" styleClass="texto-secundario"/>
                <Label fx:id="etiquetaUsuarios" styleClass="tarjeta-valor"/>
            </VBox>
            <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Billeteras" styleClass="texto-secundario"/>
                <Label fx:id="etiquetaBilleteras" styleClass="tarjeta-valor"/>
            </VBox>
            <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Transacciones exitosas" styleClass="texto-secundario"/>
                <Label fx:id="etiquetaTransacciones" styleClass="tarjeta-valor"/>
            </VBox>
            <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Monto total movilizado" styleClass="texto-secundario"/>
                <Label fx:id="etiquetaMonto" styleClass="tarjeta-valor"/>
            </VBox>
        </HBox>

        <VBox styleClass="tarjeta">
            <Label text="Monto movilizado y usuario más activo en un período" styleClass="subtitulo"/>
            <HBox spacing="8" alignment="BOTTOM_LEFT">
                <VBox spacing="4">
                    <Label text="Desde"/>
                    <DatePicker fx:id="campoDesde" prefWidth="150"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Hasta"/>
                    <DatePicker fx:id="campoHasta" prefWidth="150"/>
                </VBox>
                <Button text="Calcular" styleClass="boton-principal" onAction="#calcularRango"/>
            </HBox>
            <Label fx:id="etiquetaMontoRango"/>
            <Label fx:id="etiquetaUsuarioActivo"/>
        </VBox>

        <HBox spacing="16">
            <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Billeteras más usadas" styleClass="subtitulo"/>
                <BarChart fx:id="graficaBilleteras" animated="false" legendVisible="false" prefHeight="300">
                    <xAxis>
                        <CategoryAxis/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Movimientos" minorTickVisible="false"/>
                    </yAxis>
                </BarChart>
            </VBox>
            <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Categorías más activas" styleClass="subtitulo"/>
                <BarChart fx:id="graficaCategorias" animated="false" legendVisible="false" prefHeight="300">
                    <xAxis>
                        <NumberAxis label="Movimientos" minorTickVisible="false"/>
                    </xAxis>
                    <yAxis>
                        <CategoryAxis/>
                    </yAxis>
                </BarChart>
            </VBox>
        </HBox>

        <VBox styleClass="tarjeta">
            <Label text="Frecuencia por tipo de transacción" styleClass="subtitulo"/>
            <BarChart fx:id="graficaTipos" animated="false" legendVisible="false" prefHeight="300">
                <xAxis>
                    <CategoryAxis/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Transacciones" minorTickVisible="false"/>
                </yAxis>
            </BarChart>
        </VBox>
    </VBox>
</ScrollPane>
