<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.fintech.controlador.SimulacionControlador"
      styleClass="contenido">
    <VBox styleClass="tarjeta">
        <Label text="Fecha y hora de la plataforma" styleClass="texto-secundario"/>
        <Label fx:id="etiquetaFecha" styleClass="fecha-grande"/>
        <HBox spacing="8">
            <Button text="+1 hora" styleClass="boton-principal" onAction="#avanzarHora"/>
            <Button text="+1 día" styleClass="boton-principal" onAction="#avanzarDia"/>
            <Button text="+1 semana" styleClass="boton-principal" onAction="#avanzarSemana"/>
        </HBox>
        <Label fx:id="etiquetaResultado" styleClass="texto-secundario" wrapText="true"/>
    </VBox>
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Operaciones programadas activas" styleClass="subtitulo"/>
            <TableView fx:id="tablaProgramadas" VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Registro de programadas" styleClass="subtitulo"/>
            <ListView fx:id="listaBitacora" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>
</VBox>
