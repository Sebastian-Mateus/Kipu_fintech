<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="co.edu.uniquindio.fintech.controlador.LoginControlador"
           styleClass="fondo-login">
    <VBox styleClass="tarjeta, tarjeta-login" maxWidth="400" maxHeight="-Infinity" spacing="16">
        <Label text="Kipu" styleClass="logo-grande"/>
        <Label text="Tus billeteras digitales en un solo lugar" styleClass="texto-secundario"/>
        <VBox spacing="4">
            <Label text="Usuario (cédula)"/>
            <TextField fx:id="campoUsuario" promptText="Ej: 1094000001"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Contraseña"/>
            <PasswordField fx:id="campoContrasena"/>
        </VBox>
        <Label fx:id="etiquetaError" styleClass="mensaje-error" wrapText="true"/>
        <Button text="Ingresar" defaultButton="true" maxWidth="Infinity" styleClass="boton-principal"
                onAction="#ingresar"/>
        <HBox alignment="CENTER" spacing="4">
            <Label text="¿No tienes cuenta?" styleClass="texto-secundario"/>
            <Hyperlink text="Regístrate" onAction="#irARegistro"/>
        </HBox>
    </VBox>
</StackPane>
