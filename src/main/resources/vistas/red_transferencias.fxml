<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.fintech.controlador.RedTransferenciasControlador"
            fitToWidth="true">
    <VBox styleClass="contenido">
        <HBox spacing="16">
            <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Rutas más frecuentes entre usuarios" styleClass="subtitulo"/>
                <TableView fx:id="tablaRutas" prefHeight="280"/>
            </VBox>
            <VBox styleClass="tarjeta" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Ciclos detectados" styleClass="subtitulo"/>
                <Label text="Plata que sale de alguien y, pasando por otros, vuelve a él"
                       styleClass="texto-secundario"/>
                <ListView fx:id="listaCiclos" prefHeight="248"/>
            </VBox>
        </HBox>
        <VBox styleClass="tarjeta">
            <Label text="Buscar camino entre dos usuarios" styleClass="subtitulo"/>
            <HBox spacing="8" alignment="BOTTOM_LEFT">
                <VBox spacing="4">
                    <Label text="Desde"/>
                    <ComboBox fx:id="comboOrigen" prefWidth="260"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Hasta"/>
                    <ComboBox fx:id="comboDestino" prefWidth="260"/>
                </VBox>
                <Button text="Buscar camino" styleClass="boton-principal" onAction="#buscarCamino"/>
            </HBox>
            <Label fx:id="etiquetaCamino" wrapText="true"/>
        </VBox>
        <VBox styleClass="tarjeta">
            <Label text="Quién le transfiere a quién" styleClass="subtitulo"/>
            <TableView fx:id="tablaRelaciones" prefHeight="320"/>
        </VBox>
    </VBox>
</ScrollPane>
